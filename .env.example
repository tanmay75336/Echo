# Database Configuration
# Default is SQLite for zero-setup local dev and testing.
# For production PostgreSQL (Supabase, Neon, etc.), update provider in prisma/schema.prisma and set:
# DATABASE_URL="postgresql://user:password@localhost:5432/echo?schema=public"
DATABASE_URL="file:./dev.db"

# Authentication Secret (Used for JWT session tokens)
# Generate a secure 32+ character key for production
AUTH_SECRET="echo_development_auth_secret_minimum_32_characters_long"

# AI Provider Configuration
# Options: "gemini" | "openai" | "mock"
# Default is "mock" if no API key is provided, ensuring 100% working functionality out-of-the-box.
AI_PROVIDER="mock"

# Google Gemini API Key (Required if AI_PROVIDER="gemini")
# Get from: https://aistudio.google.com
GEMINI_API_KEY=""

# OpenAI API Key (Required if AI_PROVIDER="openai")
# Get from: https://platform.openai.com
OPENAI_API_KEY=""

# Next.js Public URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
